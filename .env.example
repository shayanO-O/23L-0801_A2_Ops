# VisionGuard Environment Variables Template
DAGSHUB_USER=
DAGSHUB_TOKEN=

# MLflow Remote Tracking (DagsHub)
MLFLOW_TRACKING_URI=https://dagshub.com/<user>/23L-0801_A2_Ops.mlflow
MLFLOW_TRACKING_USERNAME=
MLFLOW_TRACKING_PASSWORD=

# Database Settings (Local / Docker Compose)
POSTGRES_USER=visionuser
POSTGRES_PASSWORD=visionpass
POSTGRES_DB=visionguard
DATABASE_URL=sqlite:///visionguard.db

# Model Serving & Deployment
MODEL_PATH=model/champion.keras
THRESHOLD=0.5252
MAX_UPLOAD_MB=10
MODEL_MODE=local
INFERENCE_MODE=local
CLOUD_API_URL=
API_URL=
API_KEY=

# AWS Cloud Deployment (Pathway C - EC2)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-2
